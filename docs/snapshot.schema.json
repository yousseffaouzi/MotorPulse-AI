{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yousseffaouzi/MotorPulse-AI/blob/main/docs/snapshot.schema.json",
  "title": "MotorPulse AI telemetry snapshot v1",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "tick",
    "recorded_at_utc",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "tick": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset_event"
      }
    }
  },
  "$defs": {
    "asset_event": {
      "type": "object",
      "required": [
        "event_id",
        "asset_id",
        "name",
        "scenario",
        "source",
        "timestamp_utc",
        "units",
        "sample_rate_hz",
        "sample_count",
        "rpm",
        "temperature_c",
        "rms_g",
        "peak_to_peak_g",
        "crest_factor",
        "health",
        "reasons"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "units": {
          "type": "object",
          "required": [
            "vibration_acceleration",
            "temperature",
            "rotational_speed"
          ],
          "properties": {
            "vibration_acceleration": {
              "const": "g"
            },
            "temperature": {
              "const": "degC"
            },
            "rotational_speed": {
              "const": "rpm"
            }
          }
        },
        "rpm": {
          "type": "number",
          "minimum": 0
        },
        "temperature_c": {
          "type": "number"
        },
        "rms_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_to_peak_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "crest_factor": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "health": {
          "enum": [
            "normal",
            "warning",
            "critical",
            "unavailable",
            "suspect"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "window_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Derived sample_count / sample_rate_hz; currently 1.0 seconds"
        },
        "shaft_frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Derived shaft 1x frequency, rpm/60"
        },
        "severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "configured_severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "configured_scenario": {
          "enum": [
            "healthy",
            "imbalance",
            "bearing_wear",
            "misalignment",
            "overload"
          ]
        },
        "onset_tick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "duration_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000
        },
        "progression": {
          "enum": [
            "constant",
            "linear",
            "exponential"
          ]
        },
        "start_severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ramp_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2,
          "maximum": 100000
        },
        "ramp_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fault_phase": {
          "enum": [
            "healthy",
            "scheduled",
            "ramping",
            "steady",
            "ended"
          ]
        },
        "spectral_window": {
          "const": "hann"
        },
        "spectral_bin_hz": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "dominant_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "shaft_1x_amplitude_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "shaft_2x_amplitude_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "band_80_400_rms_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rolling_window_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "rolling_observations": {
          "type": "integer",
          "minimum": 1
        },
        "rolling_rms_mean_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rolling_temperature_mean_c": {
          "type": "number"
        },
        "sensor_quality": {
          "enum": [
            "good",
            "missing",
            "outlier"
          ]
        },
        "sensor_quality_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensor_drift_g": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "load_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rolling_valid_observations": {
          "type": "integer",
          "minimum": 0
        },
        "operating_config": {
          "type": "object",
          "properties": {
            "speed_variation_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "load_variation_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.3
            },
            "sensor_noise_g": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1
            },
            "sensor_drift_g_per_tick": {
              "type": "number",
              "minimum": -0.001,
              "maximum": 0.001
            }
          },
          "required": [
            "speed_variation_pct",
            "load_variation_pct",
            "sensor_noise_g",
            "sensor_drift_g_per_tick"
          ]
        }
      }
    }
  }
}
